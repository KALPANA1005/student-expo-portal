PORT=5000
NODE_ENV=development

# Your real MongoDB Atlas connection string goes here
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/student_expo_portal?appName=Cluster0

JWT_SECRET=replace_this_with_a_long_random_secret_key
JWT_EXPIRE=7d

CLIENT_URL=http://localhost:5500

# ----- Email settings (for auto Approve/Reject mail to students) -----
# EMAIL_USER = your own Gmail address
# EMAIL_PASS = a 16-character "App Password" (NOT your normal Gmail password)
# How to get an App Password is explained in README.txt
EMAIL_USER=youremail@gmail.com
EMAIL_PASS=your16digitapppassword
